{
  "name": "pr-agent",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [7224, 3000, 5432],
  "postCreateCommand": "npm install -g --ignore-scripts=false @nubjs/nub && nub install",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "containerEnv": {
    "DATABASE_URL": "postgres://pr_agent:pr_agent@localhost:5432/pr_agent"
  },
  "runArgs": ["--network=host"],
  "onCreateCommand": "cp -n .env.example .env || true"
}
