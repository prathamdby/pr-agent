# Example environment for `pr-agent`

# --- HTTP ---
# Default for Docker Compose in this repo is 7224; override locally if needed (`npm run dev`)
PORT=7224

LOG_LEVEL=info

# --- GitHub App ---
GITHUB_APP_ID=123456
# PEM content; use `\n` for real newlines in `.env` single-line PEM
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Webhooks ---
# Required (non-empty) — omitting this makes the process exit at boot
WEBHOOK_SECRET=replace-with-a-strong-secret

# --- LLM (@earendil-works/pi-ai) ---
# Provider id must match pi-ai registry (e.g. openai, anthropic, google).
PI_PROVIDER=openai
PI_MODEL=gpt-4o-mini

# Optional: cap tool/model round-trips per webhook
MAX_TOOL_ROUNDS=24

# Extra complete() passes when the main loop exits but tool results still need a model reply
MAX_FINALIZE_ROUNDS=6

# Publish attempts when submitReview never succeeds (investigation + recovery nudges per attempt)
MAX_REVIEW_PUBLISH_ATTEMPTS=3

# Max concurrent full review runs (automated + slash-command-triggered)
REVIEW_CONCURRENCY=2

# Max P0/P1/P2 findings rendered inline and in the review summary table (schema cap is 8)
MAX_REVIEW_FINDINGS=8

# Optional PR labels from structured review
ENABLE_REVIEW_LABELS_EFFORT=true
ENABLE_REVIEW_LABELS_SECURITY=false

# Soft budget (ms) for end-to-end webhook handling; exceeding it emits `webhook_timeout_budget_exceeded`
WEBHOOK_TIMEOUT_MS=10000

# Provider secrets are read by pi-ai from env (not validated in loadConfig()); set the ones your PI_PROVIDER needs
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Context7 (optional — agent uses for library-docs lookup) ---
# Anonymous calls work for public libraries with rate limits.
# Get a key at https://context7.com/dashboard for higher limits + private repos.
CONTEXT7_API_KEY=

# --- Docker Compose ---
# Compose loads this file by default (`env_file: .env`). For a one-off alternate path use:
#   PR_AGENT_ENV_FILE=/path/to/.env docker compose up
