# Example environment for `pr-agent`

# --- HTTP ---
# Default for Docker Compose in this repo is 7224; override locally if needed (`pnpm dev`)
PORT=7224

# --- Process role (required for correct behavior) ---
# web: /health + /webhooks (enqueue only). worker: ack + review + ask consumers.
# Local dev needs both terminals; Compose runs pr-agent-web and pr-agent-worker.
ROLE=web

LOG_LEVEL=info
# Max sub-events per wide log line (worker job / webhook request); default 128
LOG_MAX_WIDE_EVENTS=128
# Pretty-print logs (default false in production, true in development)
# LOG_PRETTY=true

# --- Postgres (required) ---
# Compose default; use the same URL for local web + worker against compose postgres
DATABASE_URL=postgres://pr_agent:pr_agent@localhost:5432/pr_agent

# --- GitHub App ---
GITHUB_APP_ID=123456
# PEM content; use `\n` for real newlines in `.env` single-line PEM
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Webhooks ---
# Required (non-empty) — omitting this makes the process exit at boot
WEBHOOK_SECRET=replace-with-a-strong-secret

# --- LLM (@earendil-works/pi-ai) ---
# Provider id must match pi-ai registry (e.g. openai, anthropic, google).
PI_PROVIDER=openai
PI_MODEL=gpt-4o-mini

# Optional: cap tool/model round-trips per review run
MAX_TOOL_ROUNDS=24

# Publish attempts when submitReview never succeeds (investigation + recovery nudges per attempt)
MAX_REVIEW_PUBLISH_ATTEMPTS=3

# Max valid submitReview publish executions per review run (default 2)
MAX_REVIEW_PUBLISH_CALLS=2

# Worker localConcurrency for pg-boss review queue (default 2)
REVIEW_CONCURRENCY=2

# Worker localConcurrency for pg-boss ask queue (default 1)
ASK_CONCURRENCY=1

# Worker localConcurrency for pg-boss acknowledgement queue (default 2)
ACK_CONCURRENCY=2

# Per-installation pg-boss group concurrency (default 2)
INSTALLATION_GROUP_CONCURRENCY=2

# Max tool/model round-trips per /ask command
MAX_ASK_TOOL_ROUNDS=12

# Extra complete() passes after /ask tool loop when the last message is still tool results
MAX_ASK_FINALIZE_ROUNDS=2

# Max P0/P1/P2 findings rendered inline and in the review summary table (schema cap is 8)
MAX_REVIEW_FINDINGS=8

# Cap listPullRequestFiles output (file count and total patch bytes)
MAX_PR_FILES_LISTED=300
MAX_PR_FILES_PATCH_BYTES=500000

# Optional PR labels from structured review
ENABLE_REVIEW_LABELS_EFFORT=true
ENABLE_REVIEW_LABELS_SECURITY=false

# Soft budget (ms) for webhook intake; exceeding emits webhook_timeout_budget_exceeded (logging only)
WEBHOOK_TIMEOUT_MS=10000

# pg-boss queue policy (see docs/agent-work-ops.md for recovery)
QUEUE_RETRY_LIMIT=3
QUEUE_RETRY_DELAY_SECONDS=30
QUEUE_RETRY_DELAY_MAX_SECONDS=300
QUEUE_EXPIRE_IN_SECONDS=3600
QUEUE_HEARTBEAT_SECONDS=60
QUEUE_RETENTION_SECONDS=1209600
QUEUE_DELETE_AFTER_SECONDS=604800

# Provider secrets are read by pi-ai from env (not validated in loadConfig()); set the ones your PI_PROVIDER needs
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Context7 (optional — agent uses for library-docs lookup) ---
# Anonymous calls work for public libraries with rate limits.
# Get a key at https://context7.com/dashboard for higher limits + private repos.
CONTEXT7_API_KEY=

# --- Docker Compose ---
# Compose loads this file by default (`env_file: .env`). For a one-off alternate path use:
#   PR_AGENT_ENV_FILE=/path/to/.env docker compose up
# Queue health and recovery: docs/agent-work-ops.md
