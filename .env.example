# Example environment for `pr-agent`
# Full catalog: docs/configuration.md

# --- HTTP / process role ---
# Default for Docker Compose in this repo is 7224; override locally if needed (`nub src/index.ts`)
PORT=7224
# web: /health + /ready + /webhooks (enqueue only).
# worker: ack, ci-refresh, review, ask, description, triage, verification, retention.
# Local dev needs both terminals; Compose runs pr-agent-web and pr-agent-worker.
ROLE=web

# --- Features (the user-facing catalog: docs/features.md) ---
# What the bot does and when it spends tokens. off = disabled entirely,
# manual = slash command only, auto = slash command + automatic trigger.
FEATURE_REVIEW=auto
FEATURE_DESCRIBE=auto
FEATURE_VERIFICATION=auto
FEATURE_ASK=manual
FEATURE_TRIAGE=manual
FEATURE_REVIEW_LABELS=effort
FEATURE_COMMIT_STATUS=false
FEATURE_TITLE_REWRITE=false

LOG_LEVEL=info
# Pretty-print logs (default false in production, true in development)
LOG_PRETTY=true
# Redact secret-shaped substrings from logs (default true, independent of NODE_ENV)
LOG_REDACT=true

# --- Postgres (required for durable agent work) ---
# Compose default; use the same URL for local web + worker against compose postgres
DATABASE_URL=postgres://pr_agent:pr_agent@localhost:5432/pr_agent

# --- GitHub App ---
GITHUB_APP_ID=123456
# PEM content; use `\n` for real newlines in `.env` single-line PEM
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Webhooks ---
WEBHOOK_SECRET=replace-with-a-strong-secret

# --- Model provider (Pi coding-agent) ---
PI_PROVIDER=openai
PI_MODEL=gpt-4o-mini
# Optional Review orchestrator overrides (empty inherits PI_PROVIDER / PI_MODEL)
PI_ORCHESTRATOR_PROVIDER=
PI_ORCHESTRATOR_MODEL=
# Optional shared fallback (both required to enable; availability failures only)
PI_FALLBACK_PROVIDER=
PI_FALLBACK_MODEL=
# Max thinking level for phase-aware thinking
PI_THINKING_CEILING=high
# Optional encrypted resume snapshots (base64 32-byte key); empty disables persistence
AGENT_RESUME_SNAPSHOT_KEY=
AGENT_RESUME_SNAPSHOT_MARGIN_SECONDS=600
AGENT_EVENTS_ENABLED=true
# Optional TTL delete for agent_events rows by recorded_at; 0 = rely on work-item retention + ON DELETE SET NULL
AGENT_EVENTS_RETENTION_SECONDS=0
FINDING_HISTORY_ENABLED=true
# Cross-PR dismissals before suppressing new inline threads (summary-only still allowed)
FINDING_HISTORY_DISMISS_SUPPRESS_AFTER=3
# Ignore repo_finding_history rows older than this many days for suppression
FINDING_HISTORY_LOOKBACK_DAYS=180
# Optional Pi models.json catalog path (default: ./models.json under process cwd; Docker: /app/models.json)
MODELS_JSON_PATH=
# Inactivity cap (ms) for a provider prompt: abort + fail the run only if the provider streams no
# activity (message/tool/turn events) for this long. Bounds hangs without capping large reviews.
PROVIDER_PROMPT_TIMEOUT_MS=300000
# Total wall-clock budget (ms) for one specialist across jitter, retries, and repair rounds.
REVIEW_SPECIALIST_TIMEOUT_MS=900000

# --- Worker concurrency (pg-boss localConcurrency; see src/agentWork/worker.ts) ---
REVIEW_CONCURRENCY=2
ASK_CONCURRENCY=1
DESCRIPTION_CONCURRENCY=1
TRIAGE_CONCURRENCY=1
VERIFICATION_CONCURRENCY=1
ACK_CONCURRENCY=2
# GitHub comment author associations allowed to run slash commands. Use * to allow all.
SLASH_ALLOWED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
INSTALLATION_GROUP_CONCURRENCY=2

# --- pg-boss queue policy (see docs/agent-work-ops.md for recovery) ---
QUEUE_RETRY_LIMIT=3
QUEUE_RETRY_DELAY_SECONDS=30
QUEUE_RETRY_DELAY_MAX_SECONDS=300
QUEUE_EXPIRE_IN_SECONDS=3600
QUEUE_HEARTBEAT_SECONDS=60
QUEUE_POLLING_INTERVAL_SECONDS=0.5
QUEUE_RETENTION_SECONDS=1209600
QUEUE_DELETE_AFTER_SECONDS=604800
# Graceful drain budget (s) for in-flight jobs on SIGTERM/SIGINT before pg-boss closes
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=25

# --- App table retention (worker runs a scheduled cleanup sweep) ---
WEBHOOK_EVENTS_RETENTION_SECONDS=2592000
AGENT_WORK_RETENTION_SECONDS=2592000
# Cron (server local time) for the sweep; set RETENTION_ENABLED=false to disable
RETENTION_CRON=17 3 * * *
RETENTION_ENABLED=true

# --- Context7 (optional) ---
CONTEXT7_API_KEY=

# --- PostHog (optional analytics) ---
# Empty token disables capture; host empty uses posthog-node default
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# --- Model provider secrets (loaded by loadConfig(), never logged) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Docker Compose ---
# Compose loads this file by default (`env_file: .env`). For a one-off alternate path use:
#   PR_AGENT_ENV_FILE=/path/to/.env docker compose up
# Queue health and recovery: docs/agent-work-ops.md
