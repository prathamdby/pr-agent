# Example environment for `pr-agent`
# Full catalog: docs/configuration.md

# --- HTTP ---
# One process serves /health, /ready, and /webhooks and runs every work kind:
# ack, ci_projection, review, ask, description, triage, verification, retention.
# Compose pins 7224. Bare `node --env-file-if-exists=.env src/index.ts` without PORT is 3000.
# Primary local start is docker-compose.dev.yml (includes a Cloudflare quick tunnel).
# See README Local development.
PORT=7224

# --- Features (the user-facing catalog: docs/features.md) ---
# Describe and verification: off = disabled entirely,
# manual = slash command only, auto = slash command + automatic trigger.
# FEATURE_ASK and FEATURE_TRIAGE accept only off | manual. auto crashes startup.
# FEATURE_REVIEW accepts manual | auto | approval. off crashes startup.
# approval reviews trusted PRs on open; untrusted forks wait for maintainer approval.
# Trusted fork associations: OWNER, MEMBER, and COLLABORATOR.
# A past contributor on a fork waits for a pull request approval or /review.
# Missing association or a deleted fork is untrusted. Already-open PRs need /review.
FEATURE_REVIEW=approval
# FEATURE_REVIEW_CADENCE accepts once | every_push. Default once.
# every_push with FEATURE_REVIEW=manual crashes startup.
FEATURE_REVIEW_CADENCE=once
FEATURE_DESCRIBE=auto
# auto spends tokens on synchronize pushes with open findings
FEATURE_VERIFICATION=auto
FEATURE_ASK=manual
FEATURE_TRIAGE=manual
FEATURE_REVIEW_LABELS=size
FEATURE_COMMIT_STATUS=false
FEATURE_TITLE_REWRITE=true

LOG_LEVEL=info
# Pretty-print logs (default false in production, true in development). Only true/false; empty uses default.
# Laptop default. On a public host set false or drop the line so NODE_ENV=production stays JSON.
LOG_PRETTY=true
# Redact secret-shaped substrings from logs (default true). Only true/false; empty uses default.
LOG_REDACT=true

# --- Durable state (SQLite) ---
# Directory for app_state.sqlite, pi_durable.sqlite, the pr-agent.lock.sqlite
# single-writer lock, and archive/ (reset pi_durable copies). Compose and the
# image set /data on a named volume. Exactly one process may use a directory;
# a second process fails fast on the lock.
SQLITE_DIR=./data
# Optional full path for app_state.sqlite. Empty keeps ${SQLITE_DIR}/app_state.sqlite.
SQLITE_DB_PATH=
# On SIGTERM/SIGINT: /webhooks returns 503, then in-flight GitHub writes get this
# long (ms) to settle before the agent harness and SQLite close. Keep Compose
# stop_grace_period at least 5s above it.
SHUTDOWN_GRACE_MS=25000
# Zero-503 reset of pi_durable.sqlite: when the file passes this size (bytes) or
# age (seconds), the service quiesces agent work, archives the file with its
# -wal and -shm under ${SQLITE_DIR}/archive/, and reopens a fresh one while
# /webhooks keeps answering 200.
PI_DURABLE_RESET_MAX_BYTES=2147483648
PI_DURABLE_RESET_MAX_AGE_SECONDS=2592000

# --- GitHub App ---
GITHUB_APP_ID=123456
# Real PEM required. This placeholder fails crypto.createPrivateKey() and the process exits.
# Compose env_file is line-oriented. Use one-line `\n` or base64. A literal PEM block often breaks.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Webhooks ---
WEBHOOK_SECRET=replace-with-a-strong-secret

# --- Model provider (Pi Core session) ---
PI_PROVIDER=openai
PI_MODEL=gpt-4o-mini
# Optional Review orchestrator overrides (empty inherits PI_PROVIDER / PI_MODEL)
PI_ORCHESTRATOR_PROVIDER=
PI_ORCHESTRATOR_MODEL=
# Optional shared fallback (both required to enable; availability failures only)
PI_FALLBACK_PROVIDER=
PI_FALLBACK_MODEL=
# Max thinking level for phase-aware thinking
PI_THINKING_CEILING=high
# Extra transport attempts per provider request on retryable 429/5xx/network failures; 0 disables transport retry
PI_PROVIDER_RETRY_MAX=2
# Cap (ms) on a provider-requested retry delay (e.g. Retry-After); must be less than PROVIDER_PROMPT_TIMEOUT_MS
PI_PROVIDER_MAX_RETRY_DELAY_MS=60000
# Agent lifecycle events through the telemetry bridge (evlog); PostHog is independently enabled by its token.
# Only true/false; empty uses default. Legacy 1/yes/TRUE crash startup.
AGENT_EVENTS_ENABLED=true
# TTL delete for agent_feedback rows. Default matches work retention (30d). 0 keeps rows forever.
AGENT_EVENTS_RETENTION_SECONDS=2592000
# Optional Pi models.json catalog path (default: ./models.json under process cwd; Docker: /app/models.json)
MODELS_JSON_PATH=
# Inactivity cap (ms) for a provider prompt: abort + fail the run only if the provider streams no
# activity (message/tool/turn events) for this long. Bounds hangs without capping large reviews.
PROVIDER_PROMPT_TIMEOUT_MS=300000
# Total wall-clock budget (ms) for one specialist across jitter, retries, and repair rounds.
REVIEW_SPECIALIST_TIMEOUT_MS=900000
# When true, a tests coverage gap must name read paths that have a content read
# in this run's evidence ledger. Path checks still apply when this is false.
# Only true/false; empty defaults to false. Not a FEATURE_* mode.
REVIEW_TESTS_EVIDENCE=false
# Open findings at this severity or stricter fail the PR Agent Review check.
# Allowed: P0, P1, P2, P3. Default P2. P3 fails only when this is P3.
# Empty is invalid. Not a FEATURE_* mode.
REVIEW_CHECK_FAIL_SEVERITY=P2

# --- Dispatcher concurrency (per work kind; see docs/agent-work-ops.md) ---
REVIEW_CONCURRENCY=2
ASK_CONCURRENCY=1
# Durable ask admission. Outstanding limits apply at actor, repository, and installation scope.
ASK_ACTOR_MAX_OUTSTANDING=2
ASK_REPOSITORY_MAX_OUTSTANDING=8
ASK_INSTALLATION_MAX_OUTSTANDING=32
# Token-bucket burst capacity and seconds per refill token.
ASK_ACTOR_BURST=3
ASK_REPOSITORY_BURST=12
ASK_INSTALLATION_BURST=48
ASK_ACTOR_REFILL_SECONDS=60
ASK_REPOSITORY_REFILL_SECONDS=10
ASK_INSTALLATION_REFILL_SECONDS=1
# Zero disables the installation-wide provider token budget.
ASK_PROVIDER_BUDGET_TOKENS=0
ASK_PROVIDER_BUDGET_WINDOW_SECONDS=86400
# Unknown provider usage consumes this reservation until the budget window resets.
ASK_PROVIDER_RESERVATION_TOKENS=16384
DESCRIPTION_CONCURRENCY=1
TRIAGE_CONCURRENCY=1
VERIFICATION_CONCURRENCY=1
ACK_CONCURRENCY=2
# GitHub comment author associations allowed to run slash commands. Use * to allow all.
# CONTRIBUTOR and NONE get webhook 200 and no reply. /help looks dead for those accounts.
SLASH_ALLOWED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
# Associations whose non-bot inline replies may support a dismissed finding. Wildcard is not allowed.
MAINTAINER_DECISION_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR

# --- Work run retry policy (retry_scheduled backoff; see docs/agent-work-ops.md) ---
QUEUE_RETRY_LIMIT=3
QUEUE_RETRY_DELAY_SECONDS=30
QUEUE_RETRY_DELAY_MAX_SECONDS=300

# --- app_state.sqlite retention (daily cleanup, then a WAL checkpoint) ---
WEBHOOK_EVENTS_RETENTION_SECONDS=2592000
AGENT_WORK_RETENTION_SECONDS=2592000
# Set RETENTION_ENABLED=false to disable the daily retention sweep
# Only true/false; empty uses default. Legacy 1/yes/TRUE crash startup.
RETENTION_ENABLED=true

# --- PostHog (optional analytics) ---
# Empty token disables capture; host empty uses posthog-node default
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# --- Model provider secrets (loaded by loadConfig(), never logged) ---
# Optional at boot. Empty still starts the service. Reviews fail later without a key.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Docker Compose ---
# Production Compose loads this file by default (`env_file: .env`).
# Maintainer-local Compose loads dev/mock.env (no PEM) unless you set:
#   PR_AGENT_ENV_FILE=/path/to/.env docker compose -f docker-compose.dev.yml up
# Work run health and recovery: docs/agent-work-ops.md
