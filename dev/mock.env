# Maintainer-local Compose defaults. Not a GitHub App and not for a public host.
# The web and worker boot script generates a throwaway PEM at process start.
# For live deliveries, start with PR_AGENT_ENV_FILE=.env after filling a real PEM.

GITHUB_APP_ID=1
WEBHOOK_SECRET=local-dev-webhook-secret
PI_PROVIDER=openai
PI_MODEL=gpt-4o-mini
LOG_PRETTY=true
