{
  "name": "pr-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware",
    "lint:backend": "oxlint --type-aware --ignore-pattern 'site/**'",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "pnpm exec knip",
    "check:code": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check",
    "check:prod-deps": "node scripts/check-production-dependency-graph.mjs",
    "pretest": "node scripts/check-effect-versions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "check:effect-versions": "node scripts/check-effect-versions.mjs",
    "site:dev": "pnpm --filter pr-agent-landing dev",
    "site:build": "pnpm --filter pr-agent-landing build"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.17",
    "@earendil-works/pi-ai": "^0.78.0",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@effect/cluster": "0.58.2",
    "@effect/experimental": "0.60.0",
    "@effect/platform": "0.96.1",
    "@effect/platform-node": "0.106.0",
    "@effect/rpc": "0.75.1",
    "@effect/sql": "0.51.1",
    "@effect/workflow": "0.18.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^16.0.0",
    "effect": "3.21.2",
    "evlog": "^2.18.1",
    "pg": "^8.21.0",
    "pg-boss": "^12.18.2",
    "posthog-node": "^5.36.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "knip": "^6.16.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ],
    "overrides": {
      "@tootallnate/once@<2.0.1": ">=2.0.1",
      "tar@<7.5.11": ">=7.5.11",
      "undici@<6.24.0": "6.24.0"
    }
  }
}
