{
  "name": "pr-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    ".",
    "site"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "nub src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "lint:backend": "oxlint --ignore-pattern 'site/**'",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:code": "nub run typecheck && nub run lint && nub run fmt:check",
    "check:prod-deps": "node scripts/check-production-dependency-graph.mjs",
    "pretest": "node scripts/check-effect-versions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:integration:inventory": "INTEGRATION_ALLOW_SKIP_WITHOUT_DB=1 vitest run -c vitest.integration.config.ts",
    "check:effect-versions": "node scripts/check-effect-versions.mjs",
    "site:dev": "nub --node run --filter pr-agent-landing dev",
    "site:build": "nub --node run --filter pr-agent-landing build",
    "site:generate-og": "nub --node run --filter pr-agent-landing generate:og"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@effect/platform": "0.97.0",
    "@effect/platform-node": "0.108.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^18.0.0",
    "@valibot/to-json-schema": "^1.7.1",
    "acorn": "^8.18.0",
    "effect": "3.22.0",
    "evlog": "2.28.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.30.0",
    "posthog-node": "5.51.7",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@effect/cluster": "0.60.0",
    "@effect/experimental": "0.61.0",
    "@effect/rpc": "0.76.0",
    "@effect/sql": "0.52.0",
    "@effect/workflow": "0.19.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@tootallnate/once@<2.0.1": ">=2.0.1",
    "brace-expansion": ">=5.0.9",
    "nanoid@<3.3.18": ">=3.3.18",
    "tar@<7.5.11": ">=7.5.11",
    "undici@<6.24.0": "6.24.0",
    "undici@>=7.0.0 <7.29.0": ">=7.29.0",
    "undici@>=8.0.0 <8.9.0": ">=8.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.2",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "nub@0.7.2"
}
