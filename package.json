{
  "name": "pr-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "site"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "lint:backend": "oxlint --deny-warnings --ignore-pattern 'site/**'",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:code": "npm run typecheck && npm run lint && npm run fmt:check",
    "check:prod-deps": "node scripts/check-production-dependency-graph.mjs",
    "test": "npm run check:effect-versions && vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:integration:inventory": "INTEGRATION_ALLOW_SKIP_WITHOUT_DB=1 vitest run -c vitest.integration.config.ts",
    "check:effect-versions": "node scripts/check-effect-versions.mjs",
    "site:dev": "npm run --workspace=pr-agent-landing dev",
    "site:build": "npm run --workspace=pr-agent-landing build",
    "site:generate-og": "npm run --workspace=pr-agent-landing generate:og",
    "check:static-baseline": "node scripts/check-static-baseline.mjs",
    "check:site-design": "node scripts/check-site-design.mjs",
    "check:agent-context": "node scripts/check-agent-context.mjs",
    "check:guards": "node scripts/check-guard-ledger.mjs && node scripts/check-static-baseline.mjs && node scripts/check-domain-guards.mjs && node scripts/check-agent-context.mjs",
    "check:commit-messages": "node scripts/check-commit-messages.mjs",
    "gen:feature-map": "node scripts/gen-feature-map.mjs",
    "gen:migration": "node scripts/gen-migration.mjs",
    "verify": "node scripts/verify.mjs",
    "dump-prompt": "node scripts/dump-prompt.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@effect/platform-node": "4.0.0",
    "@ff-labs/fff-node": "0.11.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^18.0.0",
    "@valibot/to-json-schema": "^1.7.1",
    "effect": "4.0.0",
    "evlog": "2.28.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.30.0",
    "posthog-node": "5.51.7",
    "quickjs-emscripten": "0.32.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@tootallnate/once@<2.0.1": ">=2.0.1",
    "brace-expansion": ">=5.0.9",
    "nanoid@<3.3.18": ">=3.3.18",
    "tar@<7.5.11": ">=7.5.11",
    "undici@<6.24.0": "6.24.0",
    "undici@>=7.0.0 <7.29.0": ">=7.29.0",
    "undici@>=8.0.0 <8.9.0": ">=8.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1 <12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^24.21.0"
  }
}
