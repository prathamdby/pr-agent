{
  "name": "pr-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    ".",
    "site"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "nub src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "lint:backend": "oxlint --ignore-pattern 'site/**'",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:code": "nub run typecheck && nub run lint && nub run fmt:check",
    "check:prod-deps": "node scripts/check-production-dependency-graph.mjs",
    "pretest": "node scripts/check-effect-versions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:integration:inventory": "INTEGRATION_ALLOW_SKIP_WITHOUT_DB=1 vitest run -c vitest.integration.config.ts",
    "check:effect-versions": "node scripts/check-effect-versions.mjs",
    "site:dev": "nub --node run --filter pr-agent-landing dev",
    "site:build": "nub --node run --filter pr-agent-landing build",
    "site:generate-og": "nub --node run --filter pr-agent-landing generate:og"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@effect/cluster": "0.60.0",
    "@effect/experimental": "0.61.0",
    "@effect/platform": "0.97.0",
    "@effect/platform-node": "0.108.0",
    "@effect/rpc": "0.76.0",
    "@effect/sql": "0.52.0",
    "@effect/workflow": "0.19.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^16.0.0",
    "effect": "3.22.0",
    "evlog": "2.22.3",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "posthog-node": "^5.46.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "oxfmt": "^0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@tootallnate/once@<2.0.1": ">=2.0.1",
    "brace-expansion": ">=5.0.8",
    "tar@<7.5.11": ">=7.5.11",
    "undici@<6.24.0": "6.24.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.2",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "nub@0.7.2"
}
