{
  "name": "pr-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:code": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check",
    "pretest": "node scripts/check-effect-versions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "perf:harness": "node scripts/review-internal-ms-harness.mjs",
    "check:effect-versions": "node scripts/check-effect-versions.mjs",
    "site:dev": "pnpm --filter pr-agent-landing dev",
    "site:build": "pnpm --filter pr-agent-landing build",
    "site:generate-og": "pnpm --filter pr-agent-landing generate:og"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.17",
    "@earendil-works/pi-ai": "^0.78.0",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@effect/platform": "0.96.1",
    "@effect/platform-node": "0.106.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/request-error": "^7.1.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^16.0.0",
    "effect": "3.21.2",
    "evlog": "^2.18.1",
    "pg": "^8.21.0",
    "pg-boss": "^12.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
