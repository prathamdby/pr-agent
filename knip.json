{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["test/**/*.{ts,tsx}!", "scripts/**/*.{js,mjs,ts}!"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "scripts/**/*.{js,mjs,ts}"]
    },
    "site": {
      "entry": ["router.tsx!", "app/**/*.{ts,tsx}!", "scripts/**/*.{js,mjs}!", "routeTree.gen.ts!"],
      "project": ["**/*.{ts,tsx,css}"]
    }
  }
}
