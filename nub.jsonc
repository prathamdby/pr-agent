{
  "$schema": "https://nubjs.com/schema/latest.json",

  "install": {
    "minimumReleaseAge": "7d",
    "minimumReleaseAgeExclude": [
      "pg-cloudflare",
      "typescript",
      "@types/*",
      "cron-parser@5.6.2",
      "oxlint@1.82.0",
      "oxlint-tsgolint@7.0.2001",
      "@oxlint/*",
      "@oxlint-tsgolint/*",
      "@tanstack/*",
      "@earendil-works/*",
      "evlog@2.28.1",
      "oxfmt@0.67.0",
      "@oxfmt/*",
      "pg-boss@12.30.0",
      "posthog-node@5.51.7",
      "@posthog/*",
      "brace-expansion@5.0.8",
      "valibot@1.5.0",
    ],
  },
}
